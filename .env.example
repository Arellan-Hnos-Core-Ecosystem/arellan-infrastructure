# Variables globales para arellan-infrastructure/docker-compose.yml
# Copiar a ".env" en este mismo directorio y completar valores reales.
# NUNCA commitear ".env" con secretos reales.

# ---------------------------------------------------------------------
# Postgres (arellan-db)
# ---------------------------------------------------------------------
POSTGRES_USER=arellan
POSTGRES_PASSWORD=changeme
POSTGRES_DB=arellan_db

# Cadena de conexion consumida por Prisma (arellan-platform)
DATABASE_URL=postgresql://arellan:changeme@arellan-db:5432/arellan_db?schema=public

# ---------------------------------------------------------------------
# Redis (arellan-cache)
# ---------------------------------------------------------------------
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@arellan-cache:6379

# ---------------------------------------------------------------------
# Auth / seguridad (arellan-platform)
# Nota: el ecosistema usa DOS secretos JWT separados (access + refresh),
# no un unico JWT_SECRET.
# ---------------------------------------------------------------------
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
INTEGRITY_HASH_SECRET=changeme-integrity-secret

# Flag Secure de cookies: "false" para stack local HTTP, "true" tras TLS
COOKIE_SECURE=false

# ---------------------------------------------------------------------
# IoT Bridge (arellan-hardware-iot <-> arellan-platform)
# ---------------------------------------------------------------------
IOT_BRIDGE_SHARED_SECRET=changeme-iot-shared-secret

# ---------------------------------------------------------------------
# Frontends (apuntan al backend en el mapa de servicios)
# ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
